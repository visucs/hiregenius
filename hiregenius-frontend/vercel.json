{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://hiregenius-auth-service.onrender.com/api/auth/:path*"
    },
    {
      "source": "/api/admin/users",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users"
    },
    {
      "source": "/api/admin/users/",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users"
    },
    {
      "source": "/api/admin/users/:id/status",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users/:id/status"
    },
    {
      "source": "/api/admin/users/:id/approve",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users/:id/approve"
    },
    {
      "source": "/api/admin/users/:id/privileges",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users/:id/privileges"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hiregenius-core-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
