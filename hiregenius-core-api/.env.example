# Server
PORT=4000
NODE_ENV=development

# JWT Secret - MUST match the Auth Service's JWT_SIGNING_KEY exactly
JWT_SIGNING_KEY=your_super_secret_jwt_signing_key_that_is_at_least_256_bits_long

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=supersecret
DB_NAME=hiregenius
DB_SSL=false
DB_POOL_MIN=1
DB_POOL_MAX=10

# API Documentation (Swagger UI)
ENABLE_SWAGGER=true
