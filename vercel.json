{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd hiregenius-frontend && npm install",
  "buildCommand": "cd hiregenius-frontend && npm run build",
  "outputDirectory": "hiregenius-frontend/dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://hiregenius-auth-service.onrender.com/api/auth/:path*"
    },
    {
      "source": "/api/admin/users",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users"
    },
    {
      "source": "/api/admin/users/",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users"
    },
    {
      "source": "/api/admin/users/:path*",
      "destination": "https://hiregenius-auth-service.onrender.com/api/admin/users/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hiregenius-core-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
