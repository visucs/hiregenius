# ==============================================================================
# HireGenius AI - Auth Service Environment Variables (.env.example)
# Copy this file to .env or configure these variables in your hosting provider (e.g. Render)
# ==============================================================================

# Server Configuration
PORT=8080

# Database Configuration (MySQL 8.0)
# Example local: jdbc:mysql://localhost:3306/hiregenius?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Example Cloud/Render: jdbc:mysql://<host>:<port>/<database>?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hiregenius?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# JWT Configuration (HS256 - must be at least 256 bits / 32 characters long)
# Must be identical across hiregenius-auth-service and hiregenius-core-api
JWT_SIGNING_KEY=your_super_secret_jwt_signing_key_that_is_at_least_32_characters_long
# Expiry in milliseconds (e.g., 86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Firebase Admin SDK Configuration
# Option A: File path to serviceAccountKey.json on server disk
FIREBASE_CREDENTIALS_PATH=
# Option B: Raw JSON content of Firebase Service Account private key (recommended for Render/cloud deployments)
FIREBASE_CREDENTIALS_JSON=

# CORS Configuration (comma-separated list of origins allowed to call the Auth API)
# In production, add your deployed Vercel frontend URL (e.g., https://hiregenius.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000
